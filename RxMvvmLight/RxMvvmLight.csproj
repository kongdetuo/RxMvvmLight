<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	  <VersionPrefix>0.1.0</VersionPrefix>
	  <GeneratePackageOnBuild>False</GeneratePackageOnBuild>
    <Authors>kongdetuo</Authors>
    <Company />
    <Description>A lightweight, AOT-friendly MVVM foundation built on R3</Description>
    <PackageProjectUrl></PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/kongdetuo/RxMvvmLight</RepositoryUrl>
    <PackageTags>R3;MVVM</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RxMvvmLight.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="R3" Version="1.3.1" />
  </ItemGroup>

</Project>
